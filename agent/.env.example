# Copy to .env and fill in. Never commit the real .env.

# LiveKit Cloud project (https://cloud.livekit.io -> project -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM: Groq Llama-3.1-70b (via OpenAI plugin)
GROQ_API_KEY=

# TTS: Rime Coda (Rime plugin)
RIME_API_KEY=

# STT is LiveKit Inference (deepgram/nova-3), keyless — no Deepgram key needed.
